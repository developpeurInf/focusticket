generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "debian-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id              String    @id @default(uuid())
  name            String
  email           String    @unique
  password        String
  role            String    @default("user") // "admin", "tech", "user"
  department      String?
  status          String    @default("active")
  createdTickets  Ticket[]  @relation("CreatedTickets")
  assignedTickets Ticket[]  @relation("AssignedTickets")
  assets          Asset[]   @relation("UserAssets")
  comments        Comment[]
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
}

model Asset {
  id             String    @id @default(uuid())
  name           String
  type           String    // "PC", "Server", "Printer", etc.
  serialNumber   String?   @unique
  projet         String?
  fabricant      String?
  produit        String?
  modele         String?
  site           String?
  status         String    @default("active") // "active", "broken", "maintenance"
  purchaseDate   DateTime?
  assignedToUser User?     @relation("UserAssets", fields: [userId], references: [id])
  userId         String?
  tickets        Ticket[]
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
}

model Ticket {
  id           String    @id @default(uuid())
  ticketNumber String?   @unique
  title        String
  description  String
  status       String    @default("open")
  priority     String    @default("medium")
  category     String?
  site         String?
  actions      String?
  creator      User      @relation("CreatedTickets", fields: [creatorId], references: [id])
  creatorId    String
  assignee     User?     @relation("AssignedTickets", fields: [assigneeId], references: [id])
  assigneeId   String?
  asset        Asset?    @relation(fields: [assetId], references: [id])
  assetId      String?
  equipment    String?
  serialNumber String?
  comment      String?
  resolvedAt   DateTime?
  actionPlan   String?   // Plan d'action initial défini à la création
  comments     Comment[]
  interventions Intervention[]
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
}

// Une étape / intervention réalisée sur un ticket (traçabilité)
model Intervention {
  id              String   @id @default(uuid())
  ticket          Ticket   @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  ticketId        String
  stepNumber      Int      // Numéro de l'étape dans le ticket (1, 2, 3...)
  performedAt     DateTime @default(now()) // Date et heure de l'intervention
  technician      String?  // Intervenant (nom)
  actions         String   // Actions réalisées
  result          String?  // Constat / résultat obtenu
  nextSteps       String?  // Prochaines étapes prévues
  durationMinutes Int?     // Durée de l'intervention en minutes
  statusAfter     String?  // Statut du ticket après l'intervention
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([ticketId])
}

model Comment {
  id        String   @id @default(uuid())
  content   String
  ticket    Ticket   @relation(fields: [ticketId], references: [id])
  ticketId  String
  author    User     @relation(fields: [authorId], references: [id])
  authorId  String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model KnowledgeArticle {
  id        String   @id @default(uuid())
  title     String
  content   String
  category  String?
  author    String?
  views     Int      @default(0)
  tags      String[] @default([])
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

